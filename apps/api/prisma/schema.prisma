  @@index([application_id])
  @@index([document_type])
  @@index([created_at])
  @@map("generated_document_evidence")
}

/// Immutable admin audit trail for legal document definition/version changes.
model LegalDocumentAuditLog {
  id                        String             @id @default(cuid())
  action                    String
  legal_document_id         String?
  legal_document_version_id String?
  document_type             LegalDocumentType?
  version_number            Int?
  document_hash             String?
  actor_user_id             String?
  actor_name_snapshot       String?
  actor_email_snapshot      String?
  before_json               Json?
  after_json                Json?
  reason                    String?
  ip_address                String?
  user_agent                String?
  correlation_id            String?
  created_at                DateTime           @default(now())

  /// Legal documents are platform-level, so there is deliberately no organization column here, and
  /// `before_json` / `after_json` already carry the structured payload instead of a metadata blob.
  actor_type  String?
  target_type String?
  target_id   String?
  source      String?
  portal      String?

  @@index([legal_document_id])
  @@index([legal_document_version_id])
  @@index([action])
  @@index([actor_user_id])
  @@index([document_type])
  @@index([created_at])
  @@index([target_type, target_id, created_at])
  @@index([correlation_id])
  @@map("legal_document_audit_logs")
}

/// Product configuration/lifecycle audit. `user_id` is the acting admin.
model ProductLog {
