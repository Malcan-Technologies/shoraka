  note_id                  String
  settlement_id            String
  investor_organization_id String
  version                  String
  status                   InvestmentSettlementConfirmationStatus    @default(PENDING)
  snapshot                 Json
  pdf_s3_key               String?
  pdf_sha256               String?
  generated_at             DateTime?
  generation_error         String?
