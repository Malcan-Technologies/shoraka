  receipt_number   String
  version          String
  status           SettlementHibahReceiptStatus  @default(PENDING)
  snapshot         Json
  pdf_s3_key       String?
  pdf_sha256       String?
  generated_at     DateTime?
  generation_error String?
  is_current       Boolean                       @default(false)
  created_at       DateTime                      @default(now())
  updated_at       DateTime                      @updatedAt
  note             Note                          @relation(fields: [note_id], references: [id], onDelete: Cascade)
  settlement       NoteSettlement                @relation(fields: [settlement_id], references: [id], onDelete: Cascade)

  @@unique([settlement_id, version], map: "settlement_hibah_receipts_settlement_version_uidx")
  @@index([note_id, version])
  @@index([status])
  @@index([receipt_number])
  @@index([settlement_id, is_current])
  @@map("settlement_hibah_receipts")
}

enum NoteInvestmentCertificateAudience {
  ADMIN
  ISSUER
  INVESTOR
}

enum NoteInvestmentCertificateStatus {
  PENDING
  READY
  FAILED
}

/// Immutable Islamic Investment Note Certificate artefacts (one row per audience/version).
/// Postgres UNIQUE treats NULLs as distinct, so audience_scope_key encodes ADMIN | ISSUER | INVESTOR:{orgId}.
model NoteInvestmentCertificate {
  id                       String                              @id @default(cuid())
  note_id                  String
  certificate_number       String
  version                  String
  audience                 NoteInvestmentCertificateAudience
  audience_scope_key       String
  investor_organization_id String?
  status                   NoteInvestmentCertificateStatus     @default(PENDING)
  snapshot                 Json
  pdf_s3_key               String?
  pdf_sha256               String?
  generated_at             DateTime?
  generation_error         String?
  is_current               Boolean                             @default(false)
  created_at               DateTime                            @default(now())
  updated_at               DateTime                            @updatedAt
  note                     Note                                @relation(fields: [note_id], references: [id], onDelete: Cascade)

  @@unique([note_id, version, audience_scope_key], map: "note_investment_certificates_scope_uidx")
  @@index([note_id, version, audience])
  @@index([investor_organization_id])
  @@index([status])
  @@index([certificate_number])
  @@index([note_id, is_current])
  @@map("note_investment_certificates")
}

