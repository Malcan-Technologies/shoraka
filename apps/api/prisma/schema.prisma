  total_equity                       Decimal?        @db.Decimal(18, 6)
  paid_up_capital                    Decimal?        @db.Decimal(18, 6)
  share_application_account          Decimal?        @db.Decimal(18, 6)
  share_premium_and_reserves         Decimal?        @db.Decimal(18, 6)
  accumulated_profit_carried_forward Decimal?        @db.Decimal(18, 6)
  equity_minority_interest           Decimal?        @db.Decimal(18, 6)
  total_liabilities                  Decimal?        @db.Decimal(18, 6)
  non_current_liabilities            Decimal?        @db.Decimal(18, 6)
  current_liabilities                Decimal?        @db.Decimal(18, 6)
  total_revenue                      Decimal?        @db.Decimal(18, 6)
  revenue_donation                   Decimal?        @db.Decimal(18, 6)
  revenue_reward                     Decimal?        @db.Decimal(18, 6)
  revenue_lending                    Decimal?        @db.Decimal(18, 6)
  revenue_equity                     Decimal?        @db.Decimal(18, 6)
  revenue_fees                       Decimal?        @db.Decimal(18, 6)
  revenue_other                      Decimal?        @db.Decimal(18, 6)
  income_deposit_interest            Decimal?        @db.Decimal(18, 6)
  income_other                       Decimal?        @db.Decimal(18, 6)
  total_cost                         Decimal?        @db.Decimal(18, 6)
  cost_staff                         Decimal?        @db.Decimal(18, 6)
  cost_system                        Decimal?        @db.Decimal(18, 6)
  cost_promotion                     Decimal?        @db.Decimal(18, 6)
  cost_other                         Decimal?        @db.Decimal(18, 6)
  profit_before_tax                  Decimal?        @db.Decimal(18, 6)
  taxation                           Decimal?        @db.Decimal(18, 6)
  profit_after_tax                   Decimal?        @db.Decimal(18, 6)
  pnl_minority_interest              Decimal?        @db.Decimal(18, 6)
  net_dividend                       Decimal?        @db.Decimal(18, 6)
  created_at                         DateTime        @default(now())
  updated_at                         DateTime        @updatedAt
  operator_profile                   OperatorProfile @relation(fields: [operator_profile_id], references: [id], onDelete: Cascade)

  @@index([operator_profile_id])
  @@index([operator_profile_id, financial_year_end])
  @@map("operator_financial_statements")
}

model IssuerOrganizationFinancialStatement {
  id                             String   @id @default(cuid())
  issuer_organization_id         String   @unique
  financial_statements           Json
  source_application_id          String?
  source_application_revision_id String?
  created_at                     DateTime @default(now())
