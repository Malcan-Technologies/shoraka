  last_value Int      @default(0)
  updated_at DateTime @updatedAt

  @@map("receipt_daily_counters")
}

/// Durable checkpoint for a Curlec order-create attempt. Written before the
/// remote Curlec call and updated with the remote order id immediately after
/// success, so a failed local GatewayPayment insert can recover the same order
/// on retry instead of creating another remote order.
model GatewayOrderAttempt {
  id              String                    @id @default(cuid())
  gatewayAccount  CurlecGatewayAccount      @map("gateway_account")
  purpose         GatewayPaymentPurpose
  scope_key       String
  idempotency_key String?
  receipt         String
  curlec_order_id String?
  amount          Decimal                   @db.Decimal(18, 6)
  currency        String                    @default("MYR")
  status          GatewayOrderAttemptStatus @default(PENDING)
  last_error_code String?
  created_at      DateTime                  @default(now())
  updated_at      DateTime                  @updatedAt

  @@unique([gatewayAccount, purpose, scope_key])
  @@index([gatewayAccount, curlec_order_id])
  @@index([status, created_at])
  @@map("gateway_order_attempts")
}

/// Admin audit trail for gateway payment status and resolution actions.
/// Event-level idempotency is deliberately NOT added here: `gateway_payments.idempotency_key`
/// already de-duplicates at the payment level, and no live writer produces an event-level key.
model GatewayPaymentEvent {
  id                 String                  @id @default(cuid())
  gateway_payment_id String
  type               GatewayPaymentEventType
  actor_user_id      String?
  from_status        GatewayPaymentStatus?
  to_status          GatewayPaymentStatus?
  reason             String?
  metadata           Json?
  created_at         DateTime                @default(now())

  /// No organization column: it is reachable through the immutable `gateway_payment_id` FK.
  actor_type     String?
  target_type    String?
  target_id      String?
  source         String?
  portal         String?
  ip_address     String?
  user_agent     String?
  correlation_id String?

  gateway_payment GatewayPayment @relation(fields: [gateway_payment_id], references: [id], onDelete: Cascade)

  @@index([gateway_payment_id, created_at])
  @@index([target_type, target_id, created_at])
  @@index([correlation_id])
  @@map("gateway_payment_events")
}

/// Raw Curlec webhook events for dedup and audit (processed in later milestones).
model GatewayWebhookEvent {
  id              String               @id @default(cuid())
  event_id        String
  event_type      String
  gatewayAccount  CurlecGatewayAccount @map("gateway_account")
  payload         Json
  signature_valid Boolean
  processed_at    DateTime?
  error           String?
  created_at      DateTime             @default(now())

  @@unique([gatewayAccount, event_id])
  @@index([event_id])
  @@index([gatewayAccount])
  @@map("gateway_webhook_events")
}

/// Daily Curlec settlement reconciliation run (one row per calendar date).
model GatewayReconRun {
  id                  String                  @id @default(cuid())
  run_date            DateTime                @db.Date
  gatewayAccount      CurlecGatewayAccount    @map("gateway_account")
  status              GatewayReconRunStatus   @default(RUNNING)
  triggered_by        String
  settlements_scanned Int                     @default(0)
  payments_matched    Int                     @default(0)
  payments_stamped    Int                     @default(0)
  exceptions_count    Int                     @default(0)
  started_at          DateTime                @default(now())
  completed_at        DateTime?
  error               String?
  created_at          DateTime                @default(now())
  exceptions          GatewayReconException[]

  @@unique([run_date, gatewayAccount])
  @@index([gatewayAccount])
  @@map("gateway_recon_runs")
}

/// Orphan or amount-mismatch flagged during a settlement recon run.
model GatewayReconException {
  id                   String                    @id @default(cuid())
  recon_run_id         String
  type                 GatewayReconExceptionType
  gateway_payment_id   String?
  curlec_payment_id    String?
  curlec_settlement_id String?
  expected_amount      Decimal?                  @db.Decimal(18, 6)
  actual_amount        Decimal?                  @db.Decimal(18, 6)
  detail               String?
  resolved_at          DateTime?
  resolved_by_user_id  String?
  resolve_reason       String?
  created_at           DateTime                  @default(now())
  recon_run            GatewayReconRun           @relation(fields: [recon_run_id], references: [id], onDelete: Cascade)
  gateway_payment      GatewayPayment?           @relation(fields: [gateway_payment_id], references: [id], onDelete: SetNull)

  @@index([recon_run_id])
  @@index([type, resolved_at])
  @@map("gateway_recon_exceptions")
}

