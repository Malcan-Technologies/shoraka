model OrganizationPartyProfile {
  id                          String                            @id @default(cuid())
  issuer_organization_id      String?
  investor_organization_id    String?
  party_key                   String
  origin                      OrganizationPartyOrigin
  membership_status           OrganizationPartyMembershipStatus
  entity_type                 OrganizationPartyEntityType
  absent_from_latest_external Boolean                           @default(false)
  name                        String?
  salutation                  String?
  identity_prefix             ScIdentityPrefix?
  identity_number             String?
  date_of_birth               DateTime?
  date_of_incorporation       DateTime?
  gender                      ScGender?
  nationality                 String?
  country_of_incorporation    String?
  address                     Json?
  is_director                 Boolean                           @default(false)
  is_shareholder              Boolean                           @default(false)
  is_board                    Boolean                           @default(false)
  is_management               Boolean                           @default(false)
  share_type                  ScShareType?
  share_type_other            String?
  shareholding_units          Decimal?                          @db.Decimal(18, 6)
  shareholding_amount         Decimal?                          @db.Decimal(18, 6)
  shareholding_percentage     Decimal?                          @db.Decimal(9, 6)
  designation                 ScDesignation?
  designation_other           String?
  appointment_date            DateTime?
  resignation_date            DateTime?
  field_sources               Json                              @default("{}")
  external_observation        Json?
  created_at                  DateTime                          @default(now())
  updated_at                  DateTime                          @updatedAt
  issuer_organization         IssuerOrganization?               @relation(fields: [issuer_organization_id], references: [id], onDelete: Cascade)
  investor_organization       InvestorOrganization?             @relation(fields: [investor_organization_id], references: [id], onDelete: Cascade)

  @@index([issuer_organization_id])
  @@index([investor_organization_id])
  @@index([issuer_organization_id, membership_status])
  @@index([investor_organization_id, membership_status])
  @@map("organization_party_profiles")
}

model OperatorProfile {
  id                          String                       @id @default(cuid())
  singleton_key               String                       @unique @default("cashsouk")
  name                        String?
  registration_number         String?
  trustee_registration_number String?
  responsible_person_name     String?
  responsible_person_phone    String?
  created_at                  DateTime                     @default(now())
  updated_at                  DateTime                     @updatedAt
  share_capital               OperatorShareCapital?
  shareholders                OperatorShareholder[]
  officers                    OperatorOfficer[]
  advisors                    OperatorAdvisor[]
  interests                   OperatorInterest[]
  financial_statements        OperatorFinancialStatement[]

  @@map("operator_profiles")
}

model OperatorShareCapital {
  id                            String          @id @default(cuid())
  operator_profile_id           String          @unique
  ordinary_units                Decimal?        @db.Decimal(18, 0)
  ordinary_amount               Decimal?        @db.Decimal(18, 6)
  preference_units              Decimal?        @db.Decimal(18, 0)
  preference_amount             Decimal?        @db.Decimal(18, 6)
  others_units                  Decimal?        @db.Decimal(18, 0)
  others_amount                 Decimal?        @db.Decimal(18, 6)
  total_paid_up_capital         Decimal?        @db.Decimal(18, 6)
  llp_members_capital_units     Decimal?        @db.Decimal(18, 0)
  llp_members_capital_amount    Decimal?        @db.Decimal(18, 6)
  llp_members_reserves_units    Decimal?        @db.Decimal(18, 0)
  llp_members_reserves_amount   Decimal?        @db.Decimal(18, 6)
  llp_subordinated_loans_units  Decimal?        @db.Decimal(18, 0)
  llp_subordinated_loans_amount Decimal?        @db.Decimal(18, 6)
  total_llp                     Decimal?        @db.Decimal(18, 6)
  created_at                    DateTime        @default(now())
  updated_at                    DateTime        @updatedAt
  operator_profile              OperatorProfile @relation(fields: [operator_profile_id], references: [id], onDelete: Cascade)

  @@map("operator_share_capital")
}

model OperatorShareholder {
  id                      String                      @id @default(cuid())
  operator_profile_id     String
  holder_type             OperatorHolderType
  entity_type             OrganizationPartyEntityType
  name                    String?
  salutation              String?
  identity_number         String?
  date_of_birth           DateTime?
  date_of_incorporation   DateTime?
  nationality             String?
  address                 String?
  date_acquired           DateTime?
  date_disposal           DateTime?
  share_type              ScShareType?
