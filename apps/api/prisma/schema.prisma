  description             String?
  audience                LegalDocumentAudience  @default(BOTH)
  required_for_onboarding Boolean                @default(true)
  public_visibility       Boolean                @default(false)
  /// When true, the active published version appears on Profile → Documents.
  show_in_account         Boolean                @default(false)
  created_at              DateTime               @default(now())
  updated_at              DateTime               @updatedAt
  versions                LegalDocumentVersion[]

  @@index([audience])
  @@index([required_for_onboarding])
  @@index([show_in_account])
  @@map("legal_documents")
}

/// One uploaded PDF version of a legal document.
model LegalDocumentVersion {
  id                    String                     @id @default(cuid())
  legal_document_id     String
  version               Int
  status                LegalDocumentVersionStatus @default(DRAFT)
  s3_key                String                     @unique
  file_name             String
  content_type          String                     @default("application/pdf")
  file_size             Int
  file_hash             String?
  reacceptance_required Boolean                    @default(false)
  uploaded_by           String
  published_by          String?
  published_at          DateTime?
  archived_by           String?
  archived_at           DateTime?
  created_at            DateTime                   @default(now())
  updated_at            DateTime                   @updatedAt
  legal_document        LegalDocument              @relation(fields: [legal_document_id], references: [id], onDelete: Cascade)
  acceptances           LegalDocumentAcceptance[]
  external_acceptances  LegalExternalAcceptance[]

  @@unique([legal_document_id, version])
  @@index([legal_document_id, status])
  @@index([status, reacceptance_required])
  /// Partial unique index (SQL migration): at most one PUBLISHED per legal_document_id.
  @@map("legal_document_versions")
}

/// Open/accept audit for an exact legal document version.
/// Acceptance is organization-scoped for portal onboarding/reacceptance:
/// only the organization owner may accept, and one ACCEPTED row per
/// (organization_id, legal_document_version_id) is sufficient for the org.
/// Individual OPENED rows may still exist per user under the composite unique key.
model LegalDocumentAcceptance {
  id                         String                  @id @default(cuid())
  legal_document_version_id  String
  /// Snapshot of definition id at open/accept (survives later config changes).
  legal_document_id          String?
  /// Snapshot of document type at open/accept.
  document_type              LegalDocumentType?
  /// Snapshot of version number at open/accept.
  version_number             Int?
  user_id                    String?
  organization_id            String?
  /// Organization display name at first open/accept.
  organization_name_snapshot String?
  /// Organization account type (PERSONAL/COMPANY) at first open/accept.
  organization_type_snapshot String?
  audience_role              LegalAcceptanceAudience
  status                     LegalAcceptanceStatus   @default(NOT_OPENED)
  opened_at                  DateTime?
  opened_ip_address          String?
  opened_user_agent          String?
  opened_device_info         String?
  accepted_at                DateTime?
  accepted_ip_address        String?
  accepted_user_agent        String?
  accepted_device_info       String?
  document_hash              String?
  /// Exact acknowledgement wording at ACCEPT time (server-validated).
  acknowledgement_text       String?
  user_email_snapshot        String?
  user_name_snapshot         String?
  created_at                 DateTime                @default(now())
  updated_at                 DateTime                @updatedAt
  user                       User?                   @relation(fields: [user_id], references: [user_id], onDelete: SetNull)
  version                    LegalDocumentVersion    @relation(fields: [legal_document_version_id], references: [id], onDelete: Restrict)

  @@unique([user_id, organization_id, legal_document_version_id])
  @@index([user_id])
  @@index([organization_id])
  @@index([legal_document_version_id])
  @@index([organization_id, status])
  @@index([document_type])
  @@index([accepted_at])
  @@index([audience_role])
  @@map("legal_document_acceptances")
}

/// Unauthenticated party open/accept of a published legal PDF (e.g. guarantor on a signing link).
/// Identified by snapshots plus a generic source pointer — not a User or organization.
model LegalExternalAcceptance {
  id                        String                         @id @default(cuid())
  legal_document_version_id String
  legal_document_id         String?
  document_type             LegalDocumentType?
  version_number            Int?
  document_hash             String?
  party_name                String
  party_email               String
  party_ic_number           String?
  source_type               LegalExternalAcceptanceSource
  source_id                 String
  status                    LegalExternalAcceptanceStatus  @default(OPENED)
  opened_at                 DateTime?
  opened_ip_address         String?
  opened_user_agent         String?
  opened_device_info        String?
  accepted_at               DateTime?
  accepted_ip_address       String?
  accepted_user_agent       String?
  accepted_device_info      String?
  acknowledgement_text      String?
  /// Denormalized linkage so evidence survives envelope/recipient deletion (no FK cascade).
  envelope_id               String?
  application_id            String?
  organization_id           String?
  party_role                String?
  created_at                DateTime                       @default(now())
  updated_at                DateTime                       @updatedAt
  version                   LegalDocumentVersion           @relation(fields: [legal_document_version_id], references: [id], onDelete: Restrict)

  @@unique([source_type, source_id, legal_document_version_id], map: "legal_ext_accept_source_version_uidx")
  @@index([source_type, source_id], map: "legal_ext_accept_source_idx")
  @@index([legal_document_version_id])
  @@index([document_type])
  @@index([accepted_at])
  @@index([envelope_id])
  @@index([application_id])
  @@index([organization_id])
  @@map("legal_external_acceptances")
}

/// Hash/version evidence for generated LO and similar documents. Not an Activity row.
model GeneratedDocumentEvidence {
