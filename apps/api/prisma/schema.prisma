generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id                          String                           @id @unique @db.VarChar(5)
  first_name                       String
  last_name                        String
  phone                            String?
  email                            String                           @unique
  cognito_sub                      String                           @unique @db.VarChar(255)
  cognito_username                 String                           @db.VarChar(255)
  investor_account                 String[]                         @default([])
  issuer_account                   String[]                         @default([])
  password_changed_at              DateTime?
  created_at                       DateTime                         @default(now())
  updated_at                       DateTime                         @updatedAt
  email_verified                   Boolean                          @default(false)
  roles                            UserRole[]
  access_logs                      AccessLog[]
  sent_admin_invitations           AdminInvitation[]                @relation("SentAdminInvitations")
  admin                            Admin?
  legal_document_acceptances       LegalDocumentAcceptance[]
  investments                      Investment[]
  sent_investor_org_invitations    InvestorOrganizationInvitation[] @relation("SentInvestorOrgInvitations")
  investor_organizations           InvestorOrganization[]
  sent_issuer_org_invitations      IssuerOrganizationInvitation[]   @relation("SentIssuerOrgInvitations")
  issuer_organizations             IssuerOrganization[]
  loans                            Loan[]
  admin_notification_logs          NotificationLog[]                @relation("AdminNotificationLogs")
  notifications                    Notification[]
  onboarding_logs                  OnboardingLog[]
  organization_memberships         OrganizationMember[]
  product_logs                     ProductLog[]
  regtank_onboarding               RegTankOnboarding[]
  triggered_application_guarantors ApplicationGuarantor[]           @relation("ApplicationGuarantorTriggeredBy")
  security_logs                    SecurityLog[]
  notification_preferences         UserNotificationPreference[]
  sessions                         UserSession[]
  authored_review_remarks          ApplicationReviewRemark[]
  signingcloud_ekyc                SigningCloudEkyc[]

  @@index([cognito_sub])
  @@map("users")
}

/// Shared SigningCloud MyKad verification keyed by signer email. Platform users have
/// `user_id` set; external signers (email link) leave it null. One verified row per email
/// is reused across issuer orgs and signing envelopes.
model SigningCloudEkyc {
  id                     String                 @id @default(cuid())
  user_id                String?                @db.VarChar(5)
  /// SigningCloud signer email (normalized lowercase).
  email                  String                 @unique
  issuer_organization_id String?
  session_token          String?                @unique
  sdk_endpoint           String?
  confirmed_name         String?
  confirmed_ic_number    String?
  doc_type               String                 @default("mykad")
  status                 SigningCloudEkycStatus @default(pending)
  last_error             String?
  completed_at           DateTime?
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt
  user                   User?                  @relation(fields: [user_id], references: [user_id], onDelete: SetNull)
  issuer_organization    IssuerOrganization?    @relation(fields: [issuer_organization_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
  @@index([completed_at])
  @@index([issuer_organization_id])
  @@map("signingcloud_ekyc")
}

model Loan {
  id              String       @id @default(cuid())
  borrower_id     String
  amount          Decimal      @db.Decimal(18, 6)
  interest_rate   Decimal      @db.Decimal(5, 2)
  duration_months Int
  purpose         String
  status          LoanStatus   @default(DRAFT)
  funded_amount   Decimal      @default(0) @db.Decimal(18, 6)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  approved_at     DateTime?
  funded_at       DateTime?
  investments     Investment[]
  borrower        User         @relation(fields: [borrower_id], references: [user_id])

  @@map("loans")
}

model Investment {
  id          String   @id @default(cuid())
  investor_id String
  loan_id     String
  amount      Decimal  @db.Decimal(18, 6)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  investor    User     @relation(fields: [investor_id], references: [user_id])
  loan        Loan     @relation(fields: [loan_id], references: [id])

  @@map("investments")
}

/// Signup/login/logout and admin-initiated account actions.
/// `user_id` is the acting user; `created_at` is the occurred-at field.
/// Standard forensic columns (actor_type/target/source/correlation_id) are additive and nullable.
/// No actor name/email snapshot: `user_id` cascade-deletes with the User, so the row cannot outlive
/// the actor it would be preserving. Snapshots are only added to tables with no User FK.
model AccessLog {
  id            String   @id @default(cuid())
  user_id       String
  event_type    String
  ip_address    String?
  user_agent    String?
  device_info   String?
  cognito_event Json?
  success       Boolean  @default(true)
  metadata      Json?
  created_at    DateTime @default(now())
  device_type   String?
  portal        String?

  actor_type     String?
  target_type    String?
  target_id      String?
  source         String?
  correlation_id String?

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@index([event_type])
  @@index([portal])
  @@index([created_at])
  @@index([user_id, created_at])
  @@index([target_type, target_id, created_at])
  @@index([correlation_id])
  @@map("access_logs")
}

model UserSession {
  id              String    @id @default(cuid())
  user_id         String
  cognito_session String    @unique @db.VarChar(512)
  ip_address      String?
  device_info     String?
  active_role     UserRole?
  last_activity   DateTime  @default(now())
  expires_at      DateTime
  revoked_at      DateTime?
  created_at      DateTime  @default(now())
  user            User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@index([cognito_session])
  @@index([expires_at])
  @@index([user_id, active_role])
  @@map("user_sessions")
}

model AdminRoleConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  badge_color String   @default("#475569")
  permissions String[] @default([])
  is_system   Boolean  @default(false)
  is_editable Boolean  @default(true)
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  admins      Admin[]

  @@index([is_system])
  @@index([is_default])
  @@map("admin_roles")
}

model Admin {
  id               String           @id @default(cuid())
  user_id          String           @unique
  role_id          String?
  role_description String
  status           String           @default("ACTIVE")
  last_login       DateTime?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  user             User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  role             AdminRoleConfig? @relation(fields: [role_id], references: [id], onDelete: SetNull)

  @@index([role_id])
  @@index([user_id])
  @@index([status])
  @@map("admins")
}

model AdminInvitation {
  id                 String    @id @default(cuid())
  email              String
  role_description   String
  token              String    @unique
  expires_at         DateTime
  accepted           Boolean   @default(false)
  accepted_at        DateTime?
  invited_by_user_id String
  created_at         DateTime  @default(now())
  invited_by         User      @relation("SentAdminInvitations", fields: [invited_by_user_id], references: [user_id])

  @@index([email])
  @@index([token])
  @@index([expires_at])
  @@map("admin_invitations")
}

/// Security-sensitive account and RBAC changes.
/// Every live writer sets `user_id` to the ACTOR (self-service or the acting admin), so no separate
/// actor column is added here. The subject of the change lives in `target_type` / `target_id`.
model SecurityLog {
  id          String   @id @default(cuid())
  user_id     String
  event_type  String
  ip_address  String?
  user_agent  String?
  device_info String?
  metadata    Json?
  created_at  DateTime @default(now())

  actor_type     String?
  target_type    String?
  target_id      String?
  source         String?
  portal         String?
  correlation_id String?

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@index([event_type])
  @@index([created_at])
  @@index([target_type, target_id, created_at])
  @@index([correlation_id])
  @@map("security_logs")
}

model OnboardingLog {
  id                       String   @id @default(cuid())
  user_id                  String
  role                     UserRole
  event_type               String
  portal                   String?
  ip_address               String?
  user_agent               String?
  device_info              String?
  device_type              String?
  metadata                 Json?
  created_at               DateTime @default(now())
  organization_name        String?
  investor_organization_id String?
  issuer_organization_id   String?

  /// `user_id` is the applicant; `actor_user_id` is who performed the action (the acting admin for
  /// AML/SSM/final-approval decisions). Derived from the admin id origin/main already put in
  /// `metadata`, so no extra query is needed on the write path.
  actor_type        String?
  actor_user_id     String?
  organization_kind String?
  target_type       String?
  target_id         String?
  source            String?
  correlation_id    String?

  investor_organization InvestorOrganization? @relation(fields: [investor_organization_id], references: [id])
  issuer_organization   IssuerOrganization?   @relation(fields: [issuer_organization_id], references: [id])
  user                  User                  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@index([role])
  @@index([event_type])
  @@index([portal])
  @@index([created_at])
  @@index([user_id, created_at])
  @@index([organization_name])
  @@index([investor_organization_id])
  @@index([issuer_organization_id])
  @@index([actor_user_id, created_at])
  @@index([target_type, target_id, created_at])
  @@index([correlation_id])
  @@map("onboarding_logs")
}

