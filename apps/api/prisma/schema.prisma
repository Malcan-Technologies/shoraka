  actor_type     String?
  target_type    String?
  target_id      String?
  source         String?
  portal         String?
  correlation_id String?

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@index([product_id])
  @@index([event_type])
  @@index([created_at])
  @@index([user_id, created_at])
  @@index([target_type, target_id, created_at])
  @@index([correlation_id])
  @@map("product_logs")
}

/// Primary application/contract/invoice/signing activity audit.
/// `user_id` is the actor, `remark` is the historical copy of the reviewer/admin remark, and
/// `created_at` is the occurred-at field.
model ApplicationLog {
  id             String  @id @default(cuid())
  /// Acting user when a human performed the change. Null for system/provider-derived rows.
  user_id        String?
  application_id String?
  event_type     String
  ip_address     String?
  user_agent     String?
  device_info    String?
  metadata       Json?
  review_cycle   Int?

  /// Deprecated in favour of event_type. Retained (never written) so historical rows keep meaning.
  level  ActivityLevel?
  target ActivityTarget?
  action ActivityAction?

  entity_id String?

  remark String?
  portal String? // ISSUER | ADMIN

  created_at DateTime @default(now())

  /// No organization column: it is reachable through `application_id`, and denormalizing it would
  /// mean an extra query inside every review transaction that writes an application log.
  actor_type     String?
  target_type    String?
  target_id      String?
  source         String?
  correlation_id String?

  @@index([user_id])
  @@index([event_type])
  @@index([created_at])
  @@index([user_id, created_at])
  @@index([application_id])
  @@index([application_id, review_cycle])
  @@index([level])
  @@index([action])
  @@index([portal])
  @@index([target_type, target_id, created_at])
  @@index([correlation_id])
  @@map("application_logs")
}

