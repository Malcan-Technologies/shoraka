  application_id String
  review_cycle   Int
  snapshot       Json
  submitted_at   DateTime
  created_at     DateTime @default(now())

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@unique([application_id, review_cycle])
  @@index([application_id])
  @@map("application_revisions")
}

model ApplicationReview {
  id               String           @id @default(cuid())
  application_id   String
  status           ReviewStepStatus @default(PENDING)
  reviewer_user_id String?
  reviewed_at      DateTime?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  section          ReviewSection
  application      Application      @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@unique([application_id, section])
  @@index([application_id])
  @@map("application_reviews")
}

model ApplicationReviewItem {
  id               String           @id @default(cuid())
  application_id   String
  item_type        String
  item_id          String
  status           ReviewStepStatus @default(PENDING)
  reviewer_user_id String?
  reviewed_at      DateTime?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  application      Application      @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@unique([application_id, item_type, item_id])
  @@index([application_id])
  @@index([application_id, item_type])
  @@map("application_review_items")
}

model ApplicationReviewRemark {
  id             String      @id(map: "application_review_notes_pkey") @default(cuid())
  application_id String
  scope          String
  scope_key      String
  action_type    String
  remark         String
  author_user_id String
  submitted_at   DateTime?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade, map: "application_review_notes_application_id_fkey")
  author         User        @relation(fields: [author_user_id], references: [user_id], onDelete: Restrict)

  @@unique([application_id, scope, scope_key], map: "application_review_remarks_application_id_scope_scope_key_key")
  @@index([application_id, scope_key], map: "application_review_notes_application_id_scope_key_idx")
  @@index([application_id, submitted_at])
  @@map("application_review_remarks")
}

/// In-transaction review/offer audit written alongside the business state change.
/// `reviewer_user_id` is the actor; `remark` is the historical copy of the reviewer remark.
model ApplicationReviewEvent {
  id               String   @id @default(cuid())
  application_id   String
  event_type       String
  scope            String?
  scope_key        String?
  old_status       String?
  new_status       String
  reviewer_user_id String?
  remark           String?
  created_at       DateTime @default(now())

  actor_type     String?
  source         String?
  portal         String?
  ip_address     String?
  user_agent     String?
  correlation_id String?
  metadata       Json?

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@index([application_id])
  @@index([application_id, created_at])
  @@index([correlation_id])
  @@map("application_review_events")
}

model Contract {
  id                         String             @id @default(cuid())
  created_at                 DateTime           @default(now())
  updated_at                 DateTime           @updatedAt
  contract_details           Json?
  offer_details              Json?
  customer_details           Json?
  issuer_organization_id     String
  status                     ContractStatus     @default(DRAFT)
  withdraw_reason            WithdrawReason?
  originating_application_id String?
  display_reference          String?            @unique
  /// Revolving ceiling. Invoices/notes remain source of truth; JSON stays in sync.
  approved_facility          Decimal            @default(0) @db.Decimal(18, 6)
  utilized_facility          Decimal            @default(0) @db.Decimal(18, 6)
  pending_facility           Decimal            @default(0) @db.Decimal(18, 6)
  repaid_facility            Decimal            @default(0) @db.Decimal(18, 6)
  available_facility         Decimal            @default(0) @db.Decimal(18, 6)
  /// Lifetime cap is contract face value; used is sum of counting invoice face values.
  lifetime_cap               Decimal            @default(0) @db.Decimal(18, 6)
  lifetime_used              Decimal            @default(0) @db.Decimal(18, 6)
  lifetime_remaining         Decimal            @default(0) @db.Decimal(18, 6)
  originating_application    Application?       @relation("ContractOriginatingApplication", fields: [originating_application_id], references: [id], onDelete: SetNull)
  applications               Application[]
  issuer_organization        IssuerOrganization @relation(fields: [issuer_organization_id], references: [id], onDelete: Cascade)
  invoices                    Invoice[]
  signing_envelopes           SigningEnvelope[]
  gateway_payments            GatewayPayment[]
  offer_accept_otp_challenges OfferAcceptOtpChallenge[]
  paymaster_id               String?
  paymaster                  Paymaster?         @relation(fields: [paymaster_id], references: [id], onDelete: SetNull)
  assignment_notices         PaymasterAssignmentNotice[]

  @@index([originating_application_id])
  @@index([display_reference])
  @@index([paymaster_id])
  @@map("contracts")
}

model Invoice {
  id                String            @id @default(cuid())
  contract_id       String?
  application_id    String
  details           Json
  offer_details     Json?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  status            InvoiceStatus     @default(DRAFT)
  withdraw_reason   WithdrawReason?
  display_reference String?           @unique
  application                   Application               @relation(fields: [application_id], references: [id], onDelete: Cascade)
  contract                      Contract?                 @relation(fields: [contract_id], references: [id])
  signing_envelopes             SigningEnvelope[]
  offer_accept_otp_challenges   OfferAcceptOtpChallenge[]
  assignment_notices            PaymasterAssignmentNotice[]

  @@index([contract_id])
  @@index([application_id])
  @@index([display_reference])
  @@map("invoices")
}

/// One-time email OTP that authorizes direct accept of a facility-linked invoice offer.
model OfferAcceptOtpChallenge {
  id                   String                     @id @default(cuid())
  application_id       String
  invoice_id           String
  contract_id          String
  requested_by_user_id String                     @db.VarChar(5)
  signatory_name       String
  signatory_email      String
  signatory_source     OfferAcceptSignatorySource
  code_hash            String
  expires_at           DateTime
  attempts             Int                        @default(0)
  consumed_at          DateTime?
  resend_count         Int                        @default(0)
  last_sent_at         DateTime
  created_at           DateTime                   @default(now())
  updated_at           DateTime                   @updatedAt

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  invoice     Invoice     @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  contract    Contract    @relation(fields: [contract_id], references: [id], onDelete: Restrict)

  @@index([application_id])
  @@index([invoice_id])
  @@index([contract_id])
  @@index([invoice_id, consumed_at])
  @@map("offer_accept_otp_challenges")
}

/// A multi-document signing package for one application/offer. All signers are external
/// parties emailed an opaque link; MyKad eKYC is shared per email via signingcloud_ekyc.
model SigningEnvelope {
  id                 String                @id @default(cuid())
  application_id     String
  /// Optional links to the offer this envelope finalizes (one of contract/invoice).
  contract_id        String?
  invoice_id         String?
  /// Product version the envelope template was built from (for auditability).
  product_version    Int?
  title              String
  status             SigningEnvelopeStatus @default(DRAFT)
  /// Admin (or system) that created/sent the envelope. Scalar audit reference to users.user_id.
  created_by_user_id String?               @db.VarChar(5)
  sent_at            DateTime?
  completed_at       DateTime?
  voided_at          DateTime?
  void_reason        String?
  expires_at         DateTime?
  provider           String                @default("signingcloud")
  /// Provider-level references (e.g. batch id) when the provider groups documents.
  provider_ref       Json?
  metadata           Json?
  created_at         DateTime              @default(now())
  updated_at         DateTime              @updatedAt

  application Application         @relation(fields: [application_id], references: [id], onDelete: Cascade)
  contract    Contract?           @relation(fields: [contract_id], references: [id], onDelete: SetNull)
  invoice     Invoice?            @relation(fields: [invoice_id], references: [id], onDelete: SetNull)
  documents   SigningDocument[]
  recipients  SigningRecipient[]
  assignments SigningAssignment[]

  @@index([application_id])
  @@index([contract_id])
  @@index([invoice_id])
  @@index([status])
  @@map("signing_envelopes")
}

/// One agreement/document inside an envelope. Each may require signatures from a
/// different subset of recipients (via SigningAssignment).
model SigningDocument {
  id                    String                @id @default(cuid())
  envelope_id           String
  name                  String
  description           String?
  source                SigningDocumentSource
  order                 Int                   @default(0)
  required              Boolean               @default(true)
  unsigned_s3_key       String?
  signed_s3_key         String?
  signed_file_sha256    String?
  /// Provider contract number for this document; used for webhook lookup (unique when set).
  provider_contract_ref String?               @unique
  status                SigningDocumentStatus @default(DRAFT)
  /// Optional pointer to the product workflow template row this document came from.
  template_ref          String?
  metadata              Json?
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt

  envelope    SigningEnvelope     @relation(fields: [envelope_id], references: [id], onDelete: Cascade)
  assignments SigningAssignment[]

  @@index([envelope_id])
  @@index([provider_contract_ref])
  @@map("signing_documents")
}

/// A party (person) acting on an envelope. All signers receive an emailed no-auth link.
/// eKYC session state is tracked per-recipient without a User row.
model SigningRecipient {
  id                       String                 @id @default(cuid())
  envelope_id              String
  /// Template role key (e.g. "issuer_director", "guarantor").
  role_key                 String
  role_label               String
  /// Scalar reference to application_guarantors.id when pre-filled from a guarantor.
  application_guarantor_id String?
  name                     String
  email                    String
  ic_number                String?
  routing_order            Int                    @default(0)
  /// When false (e.g. some guarantor roles), MyKad eKYC is skipped for this signer.
  kyc_required             Boolean                @default(true)
  status                   SigningRecipientStatus @default(PENDING)
  /// SHA-256 hash of the opaque token embedded in the no-auth signing link.
  access_token_hash        String?                @unique
  access_token_expires_at  DateTime?
  /// Set when the signer passes the IC access-code gate on the external page.
  access_code_verified_at  DateTime?
  sent_at                  DateTime?
  viewed_at                DateTime?
  completed_at             DateTime?
  declined_at              DateTime?
  decline_reason           String?
  last_reminder_at         DateTime?
  metadata                 Json?
  created_at               DateTime               @default(now())
  updated_at               DateTime               @updatedAt

  envelope    SigningEnvelope     @relation(fields: [envelope_id], references: [id], onDelete: Cascade)
  assignments SigningAssignment[]

  @@index([envelope_id])
  @@index([email])
  @@index([status])
  @@map("signing_recipients")
}

/// The document x recipient matrix: who must act on which document, with per-signer
/// signature-field placement (signset) and independent status.
model SigningAssignment {
  id           String                  @id @default(cuid())
  envelope_id  String
  document_id  String
  recipient_id String
  required     Boolean                 @default(true)
  action       SigningAction           @default(SIGN)
  /// Per-signer signature field placement for this document (SigningCloud signset).
  signset      Json?
  status       SigningAssignmentStatus @default(PENDING)
  signed_at    DateTime?
  declined_at  DateTime?
  created_at   DateTime                @default(now())
  updated_at   DateTime                @updatedAt

  envelope  SigningEnvelope  @relation(fields: [envelope_id], references: [id], onDelete: Cascade)
  document  SigningDocument  @relation(fields: [document_id], references: [id], onDelete: Cascade)
  recipient SigningRecipient @relation(fields: [recipient_id], references: [id], onDelete: Cascade)

  @@unique([document_id, recipient_id])
  @@index([envelope_id])
  @@index([document_id])
  @@index([recipient_id])
  @@map("signing_assignments")
}

model Note {
  id                              String                      @id @default(cuid())
  source_application_id           String
  source_contract_id              String?
  source_invoice_id               String?                     @unique
  issuer_organization_id          String
  status                          NoteStatus                  @default(DRAFT)
  listing_status                  NoteListingStatus           @default(NOT_LISTED)
  funding_status                  NoteFundingStatus           @default(NOT_OPEN)
  servicing_status                NoteServicingStatus         @default(NOT_STARTED)
  title                           String
  note_reference                  String                      @unique
  product_snapshot                Json?
  purpose_snapshot                Json?
  prospectus_snapshot             Json?
  issuer_snapshot                 Json
  paymaster_id                    String?
  paymaster_snapshot              Json?
  contract_snapshot               Json?
  invoice_snapshot                Json?
  requested_amount                Decimal                     @db.Decimal(18, 6)
  target_amount                   Decimal                     @db.Decimal(18, 6)
  funded_amount                   Decimal                     @default(0) @db.Decimal(18, 6)
  minimum_funding_percent         Decimal                     @default(80) @db.Decimal(5, 2)
  profit_rate_percent             Decimal?                    @db.Decimal(7, 4)
  platform_fee_rate_percent       Decimal                     @default(0) @db.Decimal(5, 2)
  service_fee_rate_percent        Decimal                     @default(0) @db.Decimal(5, 2)
  service_fee_customer_scope      String?
  is_featured                     Boolean                     @default(false)
  featured_rank                   Int?
  featured_from                   DateTime?
  featured_until                  DateTime?
  maturity_date                   DateTime?
  /// Null = grandfathered legacy profit engine. Set = tenure-based engine.
  tenure_days                     Int?
  disbursement_value_date         DateTime?
  grace_period_days               Int                         @default(7)
  arrears_threshold_days          Int                         @default(14)
  tawidh_rate_cap_percent         Decimal                     @default(1) @db.Decimal(5, 2)
  gharamah_rate_cap_percent       Decimal                     @default(9) @db.Decimal(5, 2)
  published_at                    DateTime?
  funding_closed_at               DateTime?
  activated_at                    DateTime?
  repaid_at                       DateTime?
  arrears_started_at              DateTime?
  default_marked_at               DateTime?
  default_marked_by_admin_user_id String?
  default_reason                  String?
  metadata                        Json?
  created_at                      DateTime                    @default(now())
  updated_at                      DateTime                    @updatedAt
  listing                         NoteListing?
  investments                     NoteInvestment[]
  payment_schedules               NotePaymentSchedule[]
  payments                        NotePayment[]
  settlements                     NoteSettlement[]
  ledger_entries                  NoteLedgerEntry[]
  events                          NoteEvent[]
  admin_actions                   NoteAdminAction[]
  prospectus_review               NoteProspectusReview?
  prospectus_publications         NoteProspectusPublication[]
  gateway_payments                GatewayPayment[]
  paymaster                       Paymaster?                  @relation(fields: [paymaster_id], references: [id], onDelete: SetNull)
  assignment_notices              PaymasterAssignmentNotice[]
  investment_certificates               NoteInvestmentCertificate[]
  settlement_hibah_receipts             SettlementHibahReceipt[]
  investment_settlement_confirmations   InvestmentSettlementConfirmation[]

  @@index([source_application_id])
  @@index([source_contract_id])
  @@index([issuer_organization_id])
  @@index([paymaster_id])
  @@index([status])
  @@index([listing_status])
  @@index([funding_status])
  @@index([servicing_status])
  @@index([is_featured, featured_rank])
  @@index([featured_from, featured_until])
  @@index([maturity_date])
  @@map("notes")
}

/// Pre-marketplace officer review of prospectus publication content (1:1 with Note).
/// Never stores Application/CTOS source data or rendered HTML/PDF.
model NoteProspectusReview {
  id                       String                      @id @default(cuid())
  note_id                  String                      @unique
  status                   ProspectusReviewStatus      @default(DRAFT)
  content_version          Int                         @default(1)
  option_catalogue_version String
  draft_content            Json                        @default("{}")
  approved_content         Json?
  /// Complete frozen prospectus built at Approve (source of publish copy).
  approved_snapshot        Json?
  approved_publication_id  String?                     @unique
  render_fingerprint       String?
  created_by_user_id       String
  updated_by_user_id       String
  approved_by_user_id      String?
  approved_at              DateTime?
  created_at               DateTime                    @default(now())
  updated_at               DateTime                    @updatedAt
  note                     Note                        @relation(fields: [note_id], references: [id], onDelete: Cascade)
  publications             NoteProspectusPublication[]

  @@index([status])
  @@index([updated_at])
  @@map("note_prospectus_reviews")
}

/// Immutable Prospectus freeze created at Approve; published_at set in publish transaction.
model NoteProspectusPublication {
  id                    String               @id @default(cuid())
  note_id               String
  prospectus_review_id  String
  content_version       Int
  snapshot              Json
  render_fingerprint    String
  approved_by_user_id   String
  approved_at           DateTime
  published_at          DateTime?
  /// Private S3 PDF generated once at Approve from frozen HTML.
  pdf_storage_bucket    String?
  pdf_storage_key       String?
  pdf_content_type      String?              @default("application/pdf")
  pdf_size_bytes        Int?
  pdf_sha256            String?
  pdf_generated_at      DateTime?
  pdf_generation_status String?              @default("PENDING")
  pdf_generation_error  String?
  pdf_snapshot_hash     String?
  pdf_page_count        Int?
  created_at            DateTime             @default(now())
  note                  Note                 @relation(fields: [note_id], references: [id], onDelete: Cascade)
  prospectus_review     NoteProspectusReview @relation(fields: [prospectus_review_id], references: [id], onDelete: Cascade)
  investments           NoteInvestment[]

  @@index([note_id])
  @@index([prospectus_review_id])
  @@index([published_at])
  @@index([pdf_storage_key])
  @@map("note_prospectus_publications")
}

/// Reusable legal customer / obligor. Not exclusive to one issuer.
model Paymaster {
  id                   String                       @id @default(cuid())
  legal_name           String
  registration_number  String
  registration_country String                       @default("MY")
  entity_type          String
  verification_status  PaymasterVerificationStatus  @default(UNVERIFIED)
  verified_at          DateTime?
  verified_by_user_id  String?                      @db.VarChar(5)
  source               String                       @default("ISSUER_APPLICATION")
  created_at           DateTime                     @default(now())
  updated_at           DateTime                     @updatedAt
  issuer_links         IssuerPaymasterLink[]
  contracts            Contract[]
  notes                Note[]
  assignment_notices   PaymasterAssignmentNotice[]

  @@unique([registration_number])
  @@index([legal_name])
  @@index([verification_status])
  @@map("paymasters")
}

/// Issuer–paymaster relationship. Related-party is stored here, not on Paymaster.
model IssuerPaymasterLink {
  id                     String             @id @default(cuid())
  issuer_organization_id String
  paymaster_id           String
  is_related_party       Boolean?
  last_used_at           DateTime           @default(now())
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt
  issuer_organization    IssuerOrganization @relation(fields: [issuer_organization_id], references: [id], onDelete: Cascade)
  paymaster              Paymaster          @relation(fields: [paymaster_id], references: [id], onDelete: Cascade)

  @@unique([issuer_organization_id, paymaster_id])
  @@index([paymaster_id])
  @@index([issuer_organization_id, last_used_at])
  @@map("issuer_paymaster_links")
}

/// Organization-level MARC assessment. Latest row is current. Historical rows stay for audit.
model IssuerOrganizationMarcAssessment {
  id                     String             @id @default(cuid())
  issuer_organization_id String
  credit_grade           String
  credit_score           Decimal?           @db.Decimal(7, 2)
  probability_of_default Decimal?           @db.Decimal(7, 4)
  report_s3_key          String?
  report_file_name       String?
  report_date            DateTime?
