  investor_organization    InvestorOrganization                      @relation(fields: [investor_organization_id], references: [id], onDelete: Cascade)

  @@unique([settlement_id, investor_organization_id, version], map: "investment_settlement_confirmations_scope_uidx")
  @@index([note_id, version])
  @@index([investor_organization_id])
  @@index([status])
  @@index([settlement_id, investor_organization_id, is_current])
  @@map("investment_settlement_confirmations")
