  organization_type        GatewayOrganizationType
  gatewayAccount           CurlecGatewayAccount    @map("gateway_account")
  investor_organization_id String?
  issuer_organization_id   String?
  application_id           String?
  contract_id              String?
  note_id                  String?
  amount                   Decimal                 @db.Decimal(18, 6)
  currency                 String                  @default("MYR")
  status                   GatewayPaymentStatus    @default(CREATED)
  curlec_order_id          String
  curlec_payment_id        String?
  method                   String?
  bank_code                String?
  payer_name               String?
  name_check_result        NameCheckResult?
  name_check_at            DateTime?
  name_checked_by_user_id  String?
  refund_reference         String?
  refund_initiated_by      String?
  refunded_at              DateTime?
  refund_notes             String?
  settlement_id            String?
  settled_at               DateTime?
  gateway_fee_amount       Decimal?                @db.Decimal(18, 6)
  idempotency_key          String                  @unique
  metadata                 Json?
  created_at               DateTime                @default(now())
  updated_at               DateTime                @updatedAt
  investor_organization    InvestorOrganization?   @relation(fields: [investor_organization_id], references: [id], onDelete: Cascade)
  issuer_organization      IssuerOrganization?     @relation(fields: [issuer_organization_id], references: [id], onDelete: Cascade)
  application              Application?            @relation(fields: [application_id], references: [id], onDelete: Cascade)
  contract                 Contract?               @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  note                     Note?                   @relation(fields: [note_id], references: [id], onDelete: Cascade)
  events                   GatewayPaymentEvent[]
  recon_exceptions         GatewayReconException[]
  receipt                  GatewayPaymentReceipt?

  @@unique([gatewayAccount, curlec_order_id])
  @@unique([gatewayAccount, curlec_payment_id])
  @@index([status, created_at])
  @@index([purpose])
  @@index([investor_organization_id])
  @@index([issuer_organization_id])
  @@index([application_id])
  @@index([contract_id])
  @@index([note_id])
  @@index([gatewayAccount])
  @@index([curlec_order_id])
  @@index([curlec_payment_id])
  @@index([gatewayAccount, settlement_id])
  @@map("gateway_payments")
}

